// Cloudflare Workers shadow deployment (OpenNext) — KHÔNG phải deployment production.
//
// Shadow này chạy song song Vercel Production (www.checkbds.online vẫn ở Vercel).
// KHÔNG cấu hình custom domain / routes cho checkbds.online ở đây.
// Cron Triggers KHÔNG bật trên Cloudflare (Vercel Cron vẫn chạy duy nhất) —
// bật song song sẽ chạy job production hai lần. Cutover là task riêng.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "checkbds-shadow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret runtime vars cho shadow. Giá trị PUBLIC (đã nằm trong bundle build)
  // hoặc cấu hình không nhạy cảm. Secret thật (service role, JEV, SePay, OpenRouter,
  // CRON_SECRET) đặt bằng `wrangler secret put`, KHÔNG bao giờ ở đây.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.checkbds.online"
  }
}
