// Cloudflare Workers deployment (OpenNext) — PRODUCTION cho www.checkbds.online.
//
// Apex checkbds.online vẫn ở Vercel (redirect 308 -> www); www serve từ Worker này.
//
// `main` trỏ vào entry TỰ VIẾT (cloudflare/worker.ts), không trỏ thẳng vào
// .open-next/worker.js: OpenNext GHI ĐÈ file generated mỗi lần build, nên muốn
// thêm scheduled() phải re-export từ một file nằm trong Git. Entry đó giữ
// nguyên `fetch` của OpenNext + 3 Durable Object class.
//
// Cron Triggers VẪN CHƯA bật trên Cloudflare (chưa có block `triggers`) — Vercel
// Cron vẫn chạy duy nhất. PR-1 chỉ thêm capability scheduled(); bật trigger là
// bước cutover riêng. Bật song song sẽ chạy job production hai lần.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "checkbds-shadow",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Image optimization qua Cloudflare Images binding — dùng Images Free tier
  // (5.000 unique transformations/tháng, $0). KHÔNG cần Images Paid add-on.
  // Thiếu binding này thì next/image trả ảnh gốc không tối ưu.
  "images": {
    "binding": "IMAGES"
  },
  // Non-secret runtime vars. Giá trị PUBLIC (đã nằm trong bundle build)
  // hoặc cấu hình không nhạy cảm. Secret thật (service role, JEV, SePay, OpenRouter,
  // CRON_SECRET) đặt bằng `wrangler secret put`, KHÔNG bao giờ ở đây.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.checkbds.online"
  },
  // Custom domain production — ĐANG LIVE. Block này chỉ sync repo với config
  // đã deploy, không phải thay đổi mới. Xoá là mất route www -> Worker.
  "routes": [
    {
      "pattern": "www.checkbds.online",
      "custom_domain": true
    }
  ],
  // Cloudflare Worker Previews BẮT BUỘC có block `previews` mới chạy được
  // `wrangler preview` (Workers Builds dùng cho PR branch). Để RỖNG có chủ đích:
  // - preview KHÔNG thừa hưởng binding/secret production
  // - KHÔNG đặt secret, route production, hay cron trigger vào đây
  // - nếu sau này preview runtime cần secret: cấu hình riêng bằng
  //   `wrangler preview base-config secret ...`, KHÔNG bao giờ commit vào Git
  // Block này không ảnh hưởng `wrangler deploy` — deploy production chỉ đọc
  // config top-level ở trên.
  "previews": {}
}
