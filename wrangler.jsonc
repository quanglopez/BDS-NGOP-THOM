// Cloudflare Workers deployment (OpenNext) — PRODUCTION cho www.checkbds.online.
//
// Apex checkbds.online vẫn ở Vercel (redirect 308 -> www); www serve từ Worker này.
// Cron Triggers KHÔNG bật trên Cloudflare (Vercel Cron vẫn chạy duy nhất) —
// bật song song sẽ chạy job production hai lần. Cutover cron là task riêng.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "checkbds-shadow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Image optimization qua Cloudflare Images binding — dùng Images Free tier
  // (5.000 unique transformations/tháng, $0). KHÔNG cần Images Paid add-on.
  // Thiếu binding này thì next/image trả ảnh gốc không tối ưu.
  "images": {
    "binding": "IMAGES"
  },
  // Non-secret runtime vars. Giá trị PUBLIC (đã nằm trong bundle build)
  // hoặc cấu hình không nhạy cảm. Secret thật (service role, JEV, SePay, OpenRouter,
  // CRON_SECRET) đặt bằng `wrangler secret put`, KHÔNG bao giờ ở đây.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.checkbds.online"
  },
  // Custom domain production — ĐANG LIVE. Block này chỉ sync repo với config
  // đã deploy, không phải thay đổi mới. Xoá là mất route www -> Worker.
  "routes": [
    {
      "pattern": "www.checkbds.online",
      "custom_domain": true
    }
  ]
}
