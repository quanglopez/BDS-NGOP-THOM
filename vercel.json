{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/radar-scan",
      "schedule": "7 3 * * *"
    },
    {
      "path": "/api/cron/radar-enrichment",
      "schedule": "37 3 * * *"
    }
  ]
}
