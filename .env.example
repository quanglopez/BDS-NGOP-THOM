# Domain chính - dùng cho sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://checkbds.online
# Google Analytics 4 (đo funnel). Chưa có thì để trống — app chạy bình thường.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Jev API key - chỉ dùng ở server (route handler), KHÔNG BAO GIỜ dùng NEXT_PUBLIC_
JEV_API_KEY=apikey_xxx

# Supabase (Auth + DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin: các email được vào /admin (cách nhau dấu phẩy)
ADMIN_EMAILS=

# SePay (VietQR thanh toán)
# SEPAY_API_KEY: key webhook, SePay gửi header Authorization: Apikey <key>
SEPAY_API_KEY=
# Tài khoản nhận tiền (dùng sinh QR + hiển thị) - ví dụ: MBB, 0123456789
NEXT_PUBLIC_SEPAY_BANK=
NEXT_PUBLIC_SEPAY_ACCOUNT=
NEXT_PUBLIC_SEPAY_BANK_NAME=

# Upstash Redis (rate limit theo IP cho /api/check) - tùy chọn
# Không có thì dùng rate limit in-memory (best-effort trên serverless)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OpenRouter (phân tích Pro nâng cao) - CHỈ server-side, KHÔNG BAO GIỜ dùng NEXT_PUBLIC_
# Chưa cấu hình thì Pro Analysis tắt êm (fallback deterministic), app vẫn chạy
OPENROUTER_API_KEY=
# Model chính. Đã audit structured output: có hỗ trợ JSON Schema.
# Đổi model không cần sửa business logic.
PRO_ANALYSIS_MODEL=qwen/qwen3.8-27b:free
# Chuỗi model fallback, phân tách bằng dấu phẩy. Thử lần lượt khi model trước
# 429 / unavailable / trả JSON sai schema / bị guard chặn.
# Hai model này KHÔNG hỗ trợ response_format -> tự động dùng strict JSON instruction.
PRO_ANALYSIS_FALLBACK_MODELS=inclusionai/ling-3.0-flash-fin:free,nvidia/nemotron-3.5-lightning:free
# Phiên bản Pro Analysis hiện hành (đổi số này = cache cũ bị coi là hết hạn)
PRO_ANALYSIS_VERSION=pro-v1
# KHÔNG có SCORING_VERSION: version scoring là constant SCORING_CODE_VERSION
# trong lib/scoring.ts, đi cùng công thức chấm điểm, không lấy từ env.
