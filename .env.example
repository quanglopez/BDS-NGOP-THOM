# Jev API key - chỉ dùng ở server (route handler), KHÔNG BAO GIỜ dùng NEXT_PUBLIC_
JEV_API_KEY=apikey_xxx

# Supabase (Auth + DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SePay (VietQR thanh toán)
# SEPAY_API_KEY: key webhook, SePay gửi header Authorization: Apikey <key>
SEPAY_API_KEY=
# Tài khoản nhận tiền (dùng sinh QR + hiển thị) - ví dụ: MBB, 0123456789
NEXT_PUBLIC_SEPAY_BANK=
NEXT_PUBLIC_SEPAY_ACCOUNT=
NEXT_PUBLIC_SEPAY_BANK_NAME=
